<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisDocs.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AegisDocs.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AegisDocs - Legal Document AI">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *">
        
        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate}"
                  DisplayMemberBinding="{Binding Name}"
                  PlaceholderText="Выберите режим анализа..."
                  HorizontalAlignment="Stretch"
                  Margin="10, 10, 10, 0"
                  ToolTip.Tip="Выберите, на что ИИ должен обратить внимание">
        </ComboBox>

        <StackPanel Grid.Row="1" Margin="10" Spacing="10">
            <Button Content="Анализировать договор" 
                    Command="{Binding LoadDocumentCommand}" 
                    Padding="15, 10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
            
            <Button Content="Выгрузить отчет (Word)" 
                    Command="{Binding ExportReportCommand}" 
                    IsVisible="{Binding IsReportReady}" 
                    Padding="15, 10"
                    Background="#4CAF50" 
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="2" Margin="10, 0, 10, 10">
            <TextBlock Text="{Binding ExtractedText}" 
                       TextWrapping="Wrap"
                       LineHeight="24"
                       FontSize="14"/>
        </ScrollViewer>
        
    </Grid>
</Window>
