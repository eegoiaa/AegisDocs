<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisDocs.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AegisDocs.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AegisDocs - Legal Document AI">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        
        <!-- 1. Выбор шаблона (блокируется на время анализа) -->
        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding Templates}"
                  SelectedItem="{Binding SelectedTemplate}"
                  DisplayMemberBinding="{Binding Name}"
                  IsEnabled="{Binding !IsAnalyzing}"
                  PlaceholderText="Выберите режим анализа..."
                  HorizontalAlignment="Stretch"
                  Margin="10, 10, 10, 0"
                  ToolTip.Tip="Выберите, на что ИИ должен обратить внимание">
        </ComboBox>

        <!-- 2. Панель кнопок управления -->
        <StackPanel Grid.Row="1" Margin="10" Spacing="10">
            
            <!-- Кнопка запуска (скрывается, если идет анализ) -->
            <Button Content="Анализировать договор" 
                    Command="{Binding LoadDocumentCommand}" 
                    IsVisible="{Binding !IsAnalyzing}"
                    Padding="15, 10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

            <!-- Кнопка отмены (появляется только во время анализа) -->
            <Button Content="Отменить анализ" 
                    Command="{Binding CancelAnalysisCommand}" 
                    IsVisible="{Binding IsAnalyzing}"
                    Background="#E53935"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="15, 10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>
            
            <!-- Кнопка отчета (появляется после анализа) -->
            <Button Content="Выгрузить отчет (Word)" 
                    Command="{Binding ExportReportCommand}" 
                    IsVisible="{Binding IsReportReady}" 
                    Padding="15, 10"
                    Background="#2196F3" 
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

            <!-- Кнопка исправленного документа (появляется после анализа) -->
            <Button Content="Применить исправления к файлу"
                    Command="{Binding GenerateCorrectedDocumentCommand}"
                    IsVisible="{Binding IsReportReady}" 
                    Padding="15, 10"
                    Background="#4CAF50" 
                    Foreground="White"
                    FontWeight="Bold"
                    CornerRadius="5"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

        </StackPanel>

        <!-- 3. Индикатор прогресса (лоадер) -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsAnalyzing}"
                     Margin="10, 0, 10, 10"
                     Height="4"/>
        
        <!-- 4. Область вывода текста и логов -->
        <ScrollViewer Grid.Row="3" Margin="10, 0, 10, 10">
            <TextBlock Text="{Binding ExtractedText}" 
                       TextWrapping="Wrap"
                       LineHeight="24"
                       FontSize="14"/>
        </ScrollViewer>
        
    </Grid>
</Window>
